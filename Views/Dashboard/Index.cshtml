@model List<WarehouseSlot>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-head">
    <div>
        <div class="eyebrow">WAREHOUSE OVERVIEW</div>
        <h1>Dashboard</h1>
        <p>Giám sát 8 ô kệ và điều khiển nhập hàng.</p>
    </div>

    <div class="live-pill">
        <span></span>
        Realtime PLC
    </div>
</div>


<div class="summary-grid">

    <div class="summary-card">
        <span>Tổng ô kệ</span>
        <strong>8</strong>
    </div>

    <div class="summary-card">
        <span>Ô trống</span>
        <strong id="emptyCount">
            @Model.Count(x => x.Status == "EMPTY")
        </strong>
    </div>

    <div class="summary-card">
        <span>Đang chứa</span>
        <strong id="occupiedCount">
            @Model.Count(x => x.Status == "OCCUPIED")
        </strong>
    </div>

    <div class="summary-card">
        <span>Đang có lệnh</span>
        <strong id="requestCount">
            @Model.Count(x => x.Status == "REQUEST")
        </strong>
    </div>

</div>


<div class="content-card">

    <div class="card-title-row">

        <div>
            <h2>Storage Slots</h2>
            <p>
                Trạng thái vật lý và lệnh hiện tại của từng ô.
            </p>
        </div>

        <div class="d-flex gap-2">

            <button
                class="btn btn-primary"
                onclick="requestInbound()">
                + Nhập hàng
            </button>

            <button
                class="btn btn-outline-danger"
                onclick="stopInbound()">
                Dừng nhập hàng
            </button>

        </div>

    </div>


    <div class="table-responsive">

        <table class="table warehouse-table align-middle">

            <thead>
                <tr>
                    <th>Ô kệ</th>
                    <th>Vị trí</th>
                    <th>Trạng thái</th>
                    <th>Cảm biến</th>
                    <th>Loại lệnh</th>
                    <th>Cập nhật cuối</th>
                </tr>
            </thead>

            <tbody id="slotTableBody">

            @foreach (var s in Model)
            {
                <tr data-slot="@s.Name">

                    <td>
                        <div class="slot-name">
                            @s.Name
                        </div>
                    </td>

                    <td>
                        Row @s.RowNo · Col @s.ColNo
                    </td>

                    <td>
                        <span class="status slot-status status-@s.Status.ToLower()">
                            @s.Status
                        </span>
                    </td>

                    <td class="slot-sensor">
                        @(s.SensorOccupied
                            ? "Có pallet"
                            : "Không có pallet")
                    </td>

                    <td class="slot-request">
                        @(s.RequestType ?? "—")
                    </td>

                    <td class="slot-update">
                        @(s.LastSensorUpdate?
                            .ToString("dd/MM/yyyy HH:mm:ss")
                            ?? "Chưa có dữ liệu")
                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>

</div>


<div id="toastBox" class="toast-box"></div>


@section Scripts {

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script>

async function post(url, body)
{
    const response = await fetch(
        url,
        {
            method: 'POST',

            headers:
            {
                'Content-Type': 'application/json'
            },

            body:
                body
                    ? JSON.stringify(body)
                    : null
        }
    );

    return await response.json();
}


async function requestInbound()
{
    const r =
        await post(
            '/Dashboard/RequestInbound'
        );

    showToast(
        r.message,
        r.ok
    );

    /*
       Sau khi gửi request,
       refresh 1 lần để cập nhật REQUEST.
       Sensor realtime sau đó sẽ do SignalR xử lý.
    */
    await refreshSlots();
}


async function stopInbound()
{
    const r =
        await post(
            '/Dashboard/StopInbound'
        );

    showToast(
        r.message,
        r.ok
    );

    await refreshSlots();
}


function showToast(message, ok)
{
    const box =
        document.getElementById(
            'toastBox'
        );

    box.innerHTML =
        `
        <div class="mini-toast ${ok ? 'ok' : 'bad'}">
            ${message}
        </div>
        `;

    setTimeout(
        () => box.innerHTML = '',
        3500
    );
}


function badge(status)
{
    return `
        <span class="status slot-status status-${status.toLowerCase()}">
            ${status}
        </span>
    `;
}


/*
    Hàm này chỉ dùng:
    - khi vừa bấm Nhập hàng
    - khi vừa bấm Dừng nhập

    KHÔNG còn setInterval 30 giây nữa.
*/
async function refreshSlots()
{
    const data =
        await fetch('/Dashboard/Slots')
            .then(r => r.json());

    updateSummary(data);

    document.getElementById(
        'slotTableBody'
    ).innerHTML =
        data.map(
            s =>
            `
            <tr data-slot="${s.name}">

                <td>
                    <div class="slot-name">
                        ${s.name}
                    </div>
                </td>

                <td>
                    Row ${s.rowNo} · Col ${s.colNo}
                </td>

                <td>
                    ${badge(s.status)}
                </td>

                <td class="slot-sensor">
                    ${
                        s.sensorOccupied
                            ? 'Có pallet'
                            : 'Không có pallet'
                    }
                </td>

                <td class="slot-request">
                    ${s.requestType ?? '—'}
                </td>

                <td class="slot-update">
                    ${
                        s.lastSensorUpdate
                            ? new Date(
                                s.lastSensorUpdate
                              ).toLocaleString('vi-VN')
                            : 'Chưa có dữ liệu'
                    }
                </td>

            </tr>
            `
        )
        .join('');
}


/*
    Cập nhật các ô thống kê phía trên.
*/
function updateSummary(data)
{
    document.getElementById(
        'emptyCount'
    ).textContent =
        data.filter(
            x => x.status === 'EMPTY'
        ).length;

    document.getElementById(
        'occupiedCount'
    ).textContent =
        data.filter(
            x => x.status === 'OCCUPIED'
        ).length;

    document.getElementById(
        'requestCount'
    ).textContent =
        data.filter(
            x => x.status === 'REQUEST'
        ).length;
}


/*
    ==========================
    SIGNALR REALTIME
    ==========================
*/

const connection =
    new signalR.HubConnectionBuilder()
        .withUrl('/warehouseHub')
        .withAutomaticReconnect()
        .build();


connection.on(
    'slotUpdated',

    function(data)
    {
        /*
            data ví dụ:

            {
                name: "R01",
                status: "OCCUPIED",
                occupied: true,
                lastUpdate: "19:20:15"
            }
        */

        const row =
            document.querySelector(
                `tr[data-slot="${data.name}"]`
            );

        if (!row)
            return;


        /*
            Cập nhật STATUS
        */

        const statusElement =
            row.querySelector(
                '.slot-status'
            );

        statusElement.textContent =
            data.status;

        statusElement.className =
            `status slot-status status-${data.status.toLowerCase()}`;


        /*
            Cập nhật SENSOR
        */

        const sensorElement =
            row.querySelector(
                '.slot-sensor'
            );

        sensorElement.textContent =
            data.occupied
                ? 'Có pallet'
                : 'Không có pallet';


        /*
            Cập nhật thời gian
        */

        const updateElement =
            row.querySelector(
                '.slot-update'
            );

        updateElement.textContent =
            data.lastUpdate
                ?? 'Chưa có dữ liệu';


        /*
            Sau khi R01/R02 thay đổi,
            cập nhật lại số lượng
            EMPTY / OCCUPIED / REQUEST.
        */

        updateSummaryFromTable();
    }
);


/*
    Tính lại summary trực tiếp từ bảng HTML.
    Không cần query database lại.
*/
function updateSummaryFromTable()
{
    const statuses =
        Array.from(
            document.querySelectorAll(
                '.slot-status'
            )
        )
        .map(
            x => x.textContent.trim()
        );

    document.getElementById(
        'emptyCount'
    ).textContent =
        statuses.filter(
            x => x === 'EMPTY'
        ).length;

    document.getElementById(
        'occupiedCount'
    ).textContent =
        statuses.filter(
            x => x === 'OCCUPIED'
        ).length;

    document.getElementById(
        'requestCount'
    ).textContent =
        statuses.filter(
            x => x === 'REQUEST'
        ).length;
}


/*
    Khởi động SignalR.
*/
connection.start()
    .then(
        () =>
        {
            console.log(
                'SignalR connected'
            );
        }
    )
    .catch(
        err =>
        {
            console.error(
                'SignalR connection error:',
                err
            );
        }
    );

</script>

}