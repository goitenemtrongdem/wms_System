<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AS/RS Warehouse</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">AS/RS <span>WMS</span></div>
        <div class="brand-sub">Warehouse Control</div>
        <nav class="nav flex-column mt-4">
            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="nav-link" asp-controller="History" asp-action="Index">History</a>
            <a class="nav-link" asp-controller="Transfer" asp-action="Index">Transfer</a>
            <a class="nav-link" asp-controller="Report" asp-action="Index">Report</a>
        </nav>
    </aside>
    <main class="main-content">
        @RenderBody()
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
